{
  "name": "vaulted-launcher",
  "productName": "VAULTED Launcher",
  "private": true,
  "version": "1.0.180",
  "description": "VAULTED — Fortnite build launcher",
  "author": "VAULTED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:syntax && npm run test:regression && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.cjs",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "test:join-watchdog": "node scripts/test-join-watchdog.cjs",
    "test:join-fallback": "node scripts/test-join-fallback.mjs",
    "test:community": "node scripts/test-community-directories.cjs",
    "test:bot-fill": "node scripts/test-bot-fill.cjs",
    "test:provider-repair": "node scripts/test-provider-repair.cjs",
    "test:provider-launch": "node scripts/test-provider-launch.cjs",
    "test:provider-verification": "node scripts/test-provider-verification.cjs",
    "test:range-download": "node scripts/test-range-download.cjs",
    "test:cleanup": "node scripts/test-cleanup.cjs",
    "test:auto-fix": "node scripts/test-auto-fix.cjs",
    "test:packaged-dlls": "node scripts/test-packaged-runtime-dlls.cjs",
    "audit:providers": "node scripts/audit-provider-links.cjs",
    "test:discord-gates": "node scripts/test-discord-gates.cjs",
    "test:redirect-runtime": "node scripts/test-redirect-runtime.cjs",
    "catalog": "node scripts/build-shop-catalog.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "check:runtime": "node scripts/verify-runtime.cjs",
    "check:runtime:packaged": "node scripts/verify-runtime.cjs --runtime-dir release/win-unpacked/resources/runtime",
    "check:providers": "node scripts/verify-provider-dlls.cjs",
    "check:providers:packaged": "node scripts/verify-provider-dlls.cjs --providers-dir=release/win-unpacked/resources/providers",
    "version:bump": "npm version patch --no-git-tag-version",
    "dist": "npm run version:bump && npm run build && npm run test:range-download && npm run test:cleanup && npm run test:auto-fix && npm run test:redirect-runtime && npm run test:discord-gates && npm run test:bot-fill && npm run test:provider-repair && npm run test:provider-launch && npm run test:provider-verification && npm run check:runtime && npm run check:providers && electron-builder --win nsis --publish never && npm run check:runtime:packaged && npm run check:providers:packaged && npm run test:packaged-dlls",
    "audit:seasons": "node scripts/audit-seasons.cjs",
    "test:regression": "node scripts/test-season-regressions.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin-full": "^26.6.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.vaulted.launcher",
    "productName": "VAULTED Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/builds.json",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "node_modules/7zip-bin-full/win/x64",
        "to": "7zip",
        "filter": [
          "7z.exe",
          "7z.dll",
          "License.txt"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "resources/providers",
        "to": "providers"
      },
      {
        "from": "resources/providers/reboot",
        "to": "providers/reboot",
        "filter": [
          "Reboot.dll",
          "Reboot-LICENSE.txt"
        ]
      },
      {
        "from": "resources/providers/runtime",
        "to": "providers/runtime"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "VAULTED-Launcher-${version}-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "toer15",
      "repo": "vaulted-launcher"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
