{
  "name": "vaulted-launcher",
  "productName": "VAULTED Launcher",
  "private": true,
  "version": "1.0.16",
  "description": "VAULTED — Fortnite build launcher",
  "author": "VAULTED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.vaulted.launcher",
    "productName": "VAULTED Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "VAULTED-Launcher-${version}-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "toer15",
      "repo": "vaulted-launcher"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
